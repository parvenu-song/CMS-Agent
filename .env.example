# Used by Docker Compose only. Local Maven does not automatically load this file.
# Replace all passwords with different random values (16+ chars, max 72 UTF-8 bytes for login).
CMS_ADMIN_PASSWORD=replace_with_unique_admin_password
CMS_EDITOR_PASSWORD=replace_with_unique_editor_password
CMS_DATABASE_PASSWORD=replace_with_unique_database_password
# false only for localhost HTTP at http://localhost:8088; true for production HTTPS.
CMS_COOKIE_SECURE=false
# Optional full HTTPS chat-completions endpoint; no model calls by default.
CMS_AGENT_URL=
CMS_AGENT_KEY=
CMS_AGENT_MODEL=
