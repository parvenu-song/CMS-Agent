{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CMS Agent Page Schema V1",
  "type":"object","additionalProperties":false,"required":["version","code","title","fields"],
  "properties":{
    "version":{"const":1},
    "code":{"type":"string","pattern":"^[a-z][a-z0-9]{1,31}$"},
    "title":{"type":"string","minLength":1,"maxLength":80},
    "fields":{"type":"array","minItems":1,"maxItems":30,"items":{"$ref":"#/$defs/field"}}
  },
  "$defs":{"field":{
    "type":"object","additionalProperties":false,"required":["name","label","type","required","list"],
    "properties":{
      "name":{"type":"string","pattern":"^[a-z][a-zA-Z0-9]{0,31}$","not":{"enum":["constructor","prototype","__proto__","id","version","createdAt","updatedAt"]}},
      "label":{"type":"string","minLength":1,"maxLength":80},
      "type":{"enum":["text","textarea","number","boolean","select"]},
      "required":{"type":"boolean"},"list":{"type":"boolean"},
      "options":{"type":["array","null"],"items":{"type":"string","minLength":1,"maxLength":80},"minItems":1,"maxItems":20,"uniqueItems":true}
    },
    "allOf":[{"if":{"properties":{"type":{"const":"select"}}},"then":{"required":["options"],"properties":{"options":{"type":"array"}}},"else":{"properties":{"options":{"type":"null"}}}}]
  }}
}
